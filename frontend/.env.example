# Frontend env (Vite). Copy to .env.local to override defaults.
#
# Default (no values set) is LOCALHOST-ONLY: the app talks to
# http://localhost:3000 even if you open it from a LAN URL — nothing silently
# targets the LAN.
#
# LAN mode (opt-in): set VITE_ENABLE_LAN_MODE=true to derive the backend URL
# from the page host instead:
#   - LAN host (e.g. 192.168.x.y) -> http://<same-host>:3000/api/v1
#   - https page (e.g. Tailscale *.ts.net) -> https/wss
# Pair this with the backend's MISSION_CONTROL_ALLOW_LAN=true and use only on
# trusted networks. A red warning banner shows whenever LAN mode is active.
# VITE_ENABLE_LAN_MODE=true
#
# Dev-server bind (localhost-only by default). VITE_BIND defaults to 127.0.0.1;
# a non-loopback value is REFUSED at startup unless VITE_ENABLE_LAN_MODE=true.
# VITE_BIND=127.0.0.1
#
# NOTE: VITE_* vars are baked in at BUILD time. The dev server picks up changes
# on restart; a production build must be REBUILT after changing them.
#
# Explicit override (always wins over the above) — point at any backend
# host/port directly:
# VITE_API_URL=http://192.168.4.82:3000/api/v1
# VITE_CABLE_URL=ws://192.168.4.82:3000/cable
